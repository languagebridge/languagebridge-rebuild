      { "path": "/schoolCode", "order": "ascending" },
      { "path": "/gradeBand", "order": "ascending" },
      { "path": "/timestamp", "order": "ascending" }
    ],
    [
      { "path": "/schoolCode", "order": "ascending" },
      { "path": "/gradeBand", "order": "ascending" },
      { "path": "/eventType", "order": "ascending" },
      { "path": "/timestamp", "order": "ascending" }
    ],
    [
      { "path": "/schoolCode", "order": "ascending" },
      { "path": "/studentCode", "order": "ascending" },
      { "path": "/timestamp", "order": "ascending" }
    ]
  ]
}
