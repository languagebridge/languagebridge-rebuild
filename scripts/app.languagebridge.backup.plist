<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LanguageBridge document backup — macOS LaunchAgent.
  Runs scripts/backup-to-drive.sh daily at 18:00 (and once at load).
  If the external drive isn't mounted the script exits cleanly and the run is a no-op.

  Install:   cp scripts/app.languagebridge.backup.plist ~/Library/LaunchAgents/
             launchctl load -w ~/Library/LaunchAgents/app.languagebridge.backup.plist
  Remove:    launchctl unload -w ~/Library/LaunchAgents/app.languagebridge.backup.plist
             rm ~/Library/LaunchAgents/app.languagebridge.backup.plist
  Run now:   launchctl start app.languagebridge.backup
  Logs:      ~/Library/Logs/languagebridge-backup.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.languagebridge.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/justinbernard/projects/languagebridge-rebuild/scripts/backup-to-drive.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/justinbernard/Library/Logs/languagebridge-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/justinbernard/Library/Logs/languagebridge-backup.log</string>
</dict>
</plist>
